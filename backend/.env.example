# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# Get this from https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that should receive Contact Us submissions.
CONTACT_TO_EMAIL=info@akadesigncenter.com

# The "from" address Resend sends as. Until you verify a sending domain
# in Resend, you must use their shared test address below — it can only
# deliver to the email address on your own Resend account.
# Once you verify a domain (e.g. akadesigncenter.com) in Resend, change
# this to something like "contact@akadesigncenter.com".
CONTACT_FROM_EMAIL=onboarding@resend.dev

# The frontend origin allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
